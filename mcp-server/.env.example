# WordPress site that has Elementor + the Xoopah Elementor MCP Bridge plugin active.
WP_BASE_URL=https://your-site.com

# A WordPress user who can edit pages, and an Application Password for them
# (WP Admin -> Users -> Profile -> Application Passwords).
WP_USER=your-wp-username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
